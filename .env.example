# Copy to .env and fill in. Never commit the real file.

# development | production
FLASK_ENV=development

# Flask session signing. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# Signs the JWTs the API issues. Use a *different* value from SECRET_KEY.
JWT_SECRET_KEY=replace-me-too

# How long a sign-in lasts before the user has to sign in again.
JWT_EXPIRES_HOURS=168

# SQLite needs no server and is the default for local development.
DATABASE_URL=sqlite:///consistency_ai.db
# MySQL:      mysql+pymysql://consistency_user:password@localhost:3306/consistency_ai
# PostgreSQL: postgresql+psycopg2://consistency_user:password@localhost:5432/consistency_ai

# Origins allowed to call the API. Only needed when the SPA is served from a
# different origin than the API (e.g. the Vite dev server on :5173).
CORS_ORIGINS=http://localhost:5173

# mock      → deterministic insights computed from your own numbers, no key needed
# anthropic → the same insights written by a model (requires ANTHROPIC_API_KEY)
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-5

# AI-answered requests one account may make per day. This is the only thing
# standing between a looping client and your whole API budget. 0 disables it.
AI_DAILY_LIMIT=100

# Set to false once you manage schema changes through database/migrations/.
AUTO_CREATE_TABLES=true

# Demo account created by `flask seed`.
SEED_EMAIL=demo@consistency.ai
SEED_PASSWORD=demo-password-123
